{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ringomate-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-20",
  "compatibility_flags": ["nodejs_compat"],
  // ringomate.sudosan.net（sudosan.net のゾーンに Workers のカスタムドメインとして付く）。workers.dev には出さない
  "routes": [{ "pattern": "ringomate.sudosan.net", "custom_domain": true }],
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/ja", "/ja/", "/mcp", "/lang"]
  }
}
